# Client / Vite build-time env (copy to .env or .env.local — gitignored).
# These are baked into the SPA at `npm run build`.

# Google Tag Manager container ID (optional). Leave empty to disable GTM.
# Example: VITE_GTM_ID=GTM-XXXXXXX
VITE_GTM_ID=

# Server AI keys do NOT go here — use .dev.vars / Cloudflare Pages secrets.
