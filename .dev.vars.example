# Copy to .dev.vars for `npm run pages:dev` (gitignored).
# At least one provider key is required for live /api/check.
#
#   cp .dev.vars.example .dev.vars
#   # edit .dev.vars — set GEMINI_API_KEY=...
#   npm run pages:dev
#
# NOTE: Do not put VITE_* vars here — Wrangler secrets are for Functions only.
# Client env (e.g. VITE_GTM_ID) belongs in .env / Cloudflare Pages *build* env.

# Gemini = most reliable free API (leave this on)
GEMINI_API_KEY=
# Optional free-ish keys — only uncomment if that console actually has free quota:
#   OpenAI Free tier: low RPD (~50/day) + model TPM/RPM. Prefer mini (gpt-5.4-mini).
#     upstream_quota = hit RPM/RPD/TPD or no usable Free access — check Usage Tiers.
#   Anthropic: trial credits only (no ongoing free tier)
#   xAI: needs trial/credits (no unlimited free)
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model selection (optional)
#   auto | free | default | (empty)  → free-tier chain with auto fallback
#   <model-id>                       → try this first, then free-tier chain
#
# Free-tier-biased chains (see functions/_lib/llm.ts FREE_TIER_MODEL_CHAINS):
#   Gemini  : flash-lite → 3.5/3.1/2.5 flash-lite → flash fallbacks
#   OpenAI  : gpt-5.4-mini → gpt-5.6-luna → legacy mini → gpt-5.5 last
#             Free org example limits: mini ~100k TPM / 10 RPM / 50 RPD / 200k TPD
#             Flagship gpt-5.5: ~10k TPM / 3 RPM / 50 RPD (avoid for pool)
#   Grok    : grok-4.5 → grok-4.3 → grok-4.20 non-reasoning → grok-4
#   Claude  : claude-haiku-4-5 → dated haiku snapshot
# ---------------------------------------------------------------------------
# GEMINI_MODEL=auto
# OPENAI_MODEL=auto
# XAI_MODEL=auto
# ANTHROPIC_MODEL=auto
#
# Pin examples (still falls back if that model fails):
# OPENAI_MODEL=gpt-5.4-mini
# XAI_MODEL=grok-4.5
# ANTHROPIC_MODEL=claude-haiku-4-5

# CHECK_MODE=multi|dual|monolith
#   multi   = sub-agents (identify/product/company/verify/alts) + AI pool (default when keys exist)
#   dual    = 1–2 calls
#   monolith = single LLM call
# CHECK_ALLOWED_ORIGINS=http://localhost:8788
# Free-server rate limits (defaults shown)
# CHECK_RATE_SHORT_LIMIT=1
# CHECK_RATE_SHORT_WINDOW_SEC=30
# CHECK_RATE_LONG_LIMIT=10
# CHECK_RATE_LONG_WINDOW_SEC=21600
# CHECK_CACHE_TTL_SEC=86400
# POOL_DISABLE_PROVIDERS=
# LOG_IP_SALT=
